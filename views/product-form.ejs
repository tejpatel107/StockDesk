<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %>
    </title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 6px;
        }

        h2 {
            margin-top: 0;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            padding: 9px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        button,
        .btn {
            padding: 9px 16px;
            border: none;
            border-radius: 4px;
            text-decoration: none;
            cursor: pointer;
        }

        button {
            background: #2563eb;
            color: white;
        }

        .cancel {
            background: #6b7280;
            color: white;
        }
    </style>
</head>

<body>

    <div class="container">

        <h2>
            <%= title %>
        </h2>

        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
            <% } %>

                <form method="POST" action="<%= product.product_sku
            ? '/products/' + encodeURIComponent(product.product_sku) + '/edit'
            : '/products/add' %>">

                    <div class="form-group">
                        <% if (product.product_id) { %>
                            <input type="hidden" name="product_id" value="<%= product.product_id %>">
                            <% } %>

                    </div>

                    <div class="form-group">
                        <label for="name">Product Name</label>
                        <input type="hidden" name="original_name" value="<%= product.product_name %>">
                        <input id="name" type="text" name="name" value="<%= product.product_name || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="sku">SKU</label>
                        <input type="hidden" name="original_sku" value="<%= product.product_sku %>">
                        <input id="sku" type="text" name="sku" value="<%= product.product_sku || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="price">Price</label>
                        <input type="hidden" name="original_price" value="<%= product.product_price %>">
                        <input id="price" type="number" name="price" value="<%= product.product_price ?? '' %>" min="0"
                            step="0.01" required>
                    </div>

                    <div class="form-group">
                        <label for="quantity">Quantity</label>
                        <input type="hidden" name="original_quantity" value="<%= product.product_stock_quantity %>">
                        <input id="quantity" type="number" name="quantity"
                            value="<%= product.product_stock_quantity ?? '' %>" min="0" required>
                    </div>

                    <div class="form-group">
                        <label for="categoryId">Category</label>
                        <input type="hidden" name="original_categoryId" value="<%= product.category_id %>">
                        <select id="categoryId" name="categoryId" required>
                            <option value="">Select Category</option>

                            <% categories.forEach(category=> { %>
                                <option value="<%= category.category_id %>" <%=String(product.category_id ?? ""
                                    )===String(category.category_id) ? "selected" : "" %>
                                    >
                                    <%= category.category_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="actions">

                        <button type="submit">
                            <%= product.product_sku ? "Update Product" : "Add Product" %>
                        </button>

                        <a href="/products" class="btn cancel">
                            Cancel
                        </a>

                    </div>

                </form>

    </div>

</body>

</html>