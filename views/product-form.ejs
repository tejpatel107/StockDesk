<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %>
    </title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 6px;
        }

        h2 {
            margin-top: 0;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            padding: 9px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        button,
        .btn {
            padding: 9px 16px;
            border: none;
            border-radius: 4px;
            text-decoration: none;
            cursor: pointer;
        }

        button {
            background: #2563eb;
            color: white;
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .cancel {
            background: #6b7280;
            color: white;
        }
    </style>
</head>

<body data-api-base="<%= apiBase %>" data-token="<%= token %>">

    <div class="container">

        <h2>
            <%= title %>
        </h2>

        <div id="error" class="error" style="display:none"></div>

        <!-- productId is empty on the Add page, set on the Edit page -->
        <form id="product-form" data-token="<%= token %>"
            data-product-id="<%= typeof productId !== 'undefined' ? productId : '' %>">

            <div class="form-group">
                <label for="name">Product Name</label>
                <input id="name" type="text" name="name" required>
            </div>

            <div class="form-group">
                <label for="sku">SKU</label>
                <input id="sku" type="text" name="sku" required>
            </div>

            <div class="form-group">
                <label for="price">Price</label>
                <input id="price" type="number" name="price" min="0" step="0.01" required>
            </div>

            <div class="form-group">
                <label for="quantity">Quantity</label>
                <input id="quantity" type="number" name="quantity" min="0" required>
            </div>

            <div class="form-group">
                <label for="categoryId">Category</label>
                <select id="categoryId" name="categoryId" required>
                    <option value="">Select Category</option>
                </select>
            </div>

            <div class="actions">
                <button id="submit-btn" type="submit">Add Product</button>
                <a href="/products" class="btn cancel">Cancel</a>
            </div>

        </form>

    </div>

    <script>
        const API_BASE = document.body.dataset.apiBase;
        const TOKEN = document.body.dataset.token;

        const form = document.getElementById("product-form");
        const errorBox = document.getElementById("error");
        const submitBtn = document.getElementById("submit-btn");
        const token = form.dataset.token;
        const productId = form.dataset.productId;
        const isEdit = Boolean(productId);

        // Values as loaded from the API, used to send only changed fields on edit
        let original = {};

        function showError(message) {
            errorBox.textContent = message;
            errorBox.style.display = "block";
            errorBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }

        function clearError() {
            errorBox.style.display = "none";
        }

        async function api(path, options = {}) {
            const res = await fetch(API_BASE + path, {
                ...options,
                headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + token,
                },
            });

            if (res.status === 401) {
                window.location.href = "/login";
                throw new Error("Session expired");
            }

            const body = await res.json().catch(() => ({}));

            // Error shape: { success: false, message: "..." }
            if (!res.ok || body.success === false) {
                throw new Error(body.message || "Request failed (" + res.status + ")");
            }

            return body;
        }

        async function init() {
            try {
                // Categories come straight from the API
                const catData = await api("/categories");
                const categories = catData.categories || catData || [];
                const select = document.getElementById("categoryId");

                categories.forEach((c) => {
                    const opt = document.createElement("option");
                    opt.value = c.category_id;
                    opt.textContent = c.category_name;
                    select.appendChild(opt);
                });

                if (!isEdit) return;

                // Edit: load the product straight from the API
                submitBtn.textContent = "Update Product";
                const prodData = await api("/products/" + encodeURIComponent(productId));
                const p = prodData.product || prodData;

                original = {
                    name: p.product_name,
                    sku: p.product_sku,
                    price: Number(p.product_price),
                    quantity: Number(p.product_stock_quantity),
                    categoryId: String(p.category_id),
                };

                form.name.value = original.name;
                form.sku.value = original.sku;
                form.price.value = original.price;
                form.quantity.value = original.quantity;
                form.categoryId.value = original.categoryId;
            } catch (err) {
                showError(err.message);
            }
        }

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            clearError();

            const current = {
                name: form.name.value.trim(),
                sku: form.sku.value.trim(),
                price: Number(form.price.value),
                quantity: Number(form.quantity.value),
                categoryId: form.categoryId.value,
            };

            submitBtn.disabled = true;

            try {
                if (isEdit) {
                    // PATCH: send only the fields that changed
                    const changes = {};
                    for (const key in current) {
                        if (current[key] !== original[key]) changes[key] = current[key];
                    }

                    if (Object.keys(changes).length === 0) {
                        showError("No changes to save");
                        submitBtn.disabled = false;
                        return;
                    }

                    // The PATCH whitelist uses category_id as the key
                    if ("categoryId" in changes) {
                        changes.category_id = changes.categoryId;
                        delete changes.categoryId;
                    }

                    await api("/products/" + encodeURIComponent(productId), {
                        method: "PATCH",
                        body: JSON.stringify(changes),
                    });
                } else {
                    await api("/products", {
                        method: "POST",
                        body: JSON.stringify(current),
                    });
                }

                window.location.href = "/products";
            } catch (err) {
                showError(err.message);
                submitBtn.disabled = false;
            }
        });

        init();
    </script>

</body>

</html>