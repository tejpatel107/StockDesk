<!doctype html>
<html>

<head>

<title><%= title %></title>

<link 
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
>

</head>


<body>


<div class="container mt-5">


<h2>
<%= title %>
</h2>



<% if(error){ %>

<div class="alert alert-danger">

<ul>


<li>
<%= error %>
</li>


</ul>

</div>

<% } %>





<form method="POST"
action="<%= product.product_id ? '/products/'+product.product_id+'/edit' : '/products/add' %>"
>


<div class="mb-3">

<label>
Product Name
</label>

<input
class="form-control"
type="text"
name="name"
value="<%= product.product_name || '' %>"
>

</div>





<div class="mb-3">

<label>
SKU
</label>

<input
class="form-control"
type="text"
name="sku"
value="<%= product.product_sku || '' %>"
>

</div>





<div class="mb-3">

<label>
Price
</label>

<input
class="form-control"
type="number"
name="price"
value="<%= product.product_price || '' %>"
>

</div>





<div class="mb-3">

<label>
Quantity
</label>


<input
class="form-control"
type="number"
name="stockQuantity"
value="<%= product.product_quantity || '' %>"
>

</div>





<div class="mb-3">


<label>
Category
</label>


<select
name="categoryId"
class="form-control"
>


<option value="">
Select Category
</option>



<% categories.forEach(category=>{ %>


<option

value="<%= category.category_id %>"

<%= product.category_id === category.category_id ? "selected" : "" %>

>

<%= category.category_name %>

</option>


<% }) %>


</select>


</div>






<button class="btn btn-primary">

Save

</button>



<a href="/products"
class="btn btn-secondary">

Cancel

</a>



</form>


</div>


</body>

</html>
