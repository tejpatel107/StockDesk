<!DOCTYPE html>
<html>
<head>
  <title>Reports</title>
</head>

<body>

<h1>Reports</h1>

<h2>Low Stock Products</h2>

<table border="1" cellpadding="5">
  <tr>
    <th>Product Name</th>
    <th>Price</th>
    <th>Quantity</th>
  </tr>

  <% lowStock.forEach(product => { %>
    <tr>
      <td><%= product.product_name %></td>
      <td><%= product.product_price %></td>
      <td><%= product.product_quantity %></td>
    </tr>
  <% }) %>
</table>

<h2>Top Products</h2>

<table border="1" cellpadding="5">
  <tr>
    <th>Product Name</th>
    <th>Revenue</th>
    <th>Total Sold</th>
  </tr>

  <% topProducts.forEach(product => { %>
    <tr>
      <td><%= product.product_name %></td>
      <td><%= product.total_revenue %></td>
      <td><%= product.total_quantity_sold %></td>
    </tr>
  <% }) %>

</table>


<h2>Sales Report</h2>

<table border="1" cellpadding="5">
  <tr>
    <th>Total Orders</th>
    <th>Total Revenue</th>
    <th>Avg Order</th>
  </tr>

  <% salesReport.forEach(sale => { %>
    <tr>
      <td><%= sale.total_orders %></td>
      <td><%= sale.total_revenue %></td>
      <td><%= sale.avg_order_value %></td>
    </tr>
  <% }) %>

</table>


</body>
</html>