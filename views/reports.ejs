<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Reports | Stock Desk</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        h1 {
            margin-bottom: 30px;
        }

        .report-section {
            background: white;
            padding: 20px;
            margin-bottom: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        h2 {
            margin-top: 0;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background: #f0f0f0;
        }

        .empty {
            color: #777;
            padding: 15px 0;
        }

        .sales-placeholder {
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #777;
            background: #fafafa;
            border: 1px dashed #ccc;
        }
    </style>
</head>

<body>

    <main class="container">

        <h1>Reports</h1>

        <!-- Low Stock Products -->
        <section class="report-section">

            <h2>Low Stock Products</h2>

            <% if (lowStock.length===0) { %>

                <p class="empty">No low stock products found.</p>

                <% } else { %>

                    <table>
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>SKU</th>
                                <th>Price</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% lowStock.forEach(product=> { %>

                                <tr>
                                    <td>
                                        <%= product.product_name %>
                                    </td>

                                    <td>
                                        <%= product.product_sku %>
                                    </td>

                                    <td>
                                        ₹<%= product.product_price %>
                                    </td>

                                    <td>
                                        <%= product.product_stock_quantity %>
                                    </td>
                                </tr>

                                <% }) %>
                        </tbody>
                    </table>

                    <% } %>

        </section>


        <!-- Top Products -->
        <section class="report-section">

            <h2>Top Products</h2>

            <% if (topProducts.length===0) { %>

                <p class="empty">No product sales found.</p>

                <% } else { %>

                    <table>
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Total Sold</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% topProducts.forEach(product=> { %>

                                <tr>
                                    <td>
                                        <%= product.product_name %>
                                    </td>

                                    <td>
                                        <%= product.total_quantity_sold %>
                                    </td>
                                </tr>

                                <% }) %>
                        </tbody>
                    </table>

                    <% } %>

        </section>


        <!-- Sales Report -->
        <section class="report-section">

            <h2>Sales Report</h2>

            <!--
                Sales report will be added here later.

                Expected fields can be:
                - total_orders
                - total_revenue
                - avg_order_value
            -->

            <div class="sales-placeholder">
                <% if (salesReport.length===0) { %>

                    <p class="empty">No product sales found.</p>

                    <% } else { %>

                        <table>
                            <thead>
                                <tr>
                                    <th>Total orders</th>
                                    <th>Total Revenue</th>
                                    <th>Average Order Value</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr>
                                    <td>
                                        <%= salesReport.total_orders %>
                                    </td>
                                    <td>
                                        <%= salesReport.total_revenue %>
                                    </td>
                                    <td>
                                        <%= salesReport.average_order_value %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <% } %>
            </div>

        </section>

    </main>

</body>

</html>