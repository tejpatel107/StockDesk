<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>StockDesk — Order Detail</title>
  <style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6f9;
    color: #333;
    padding: 20px;
  }

  main {
    max-width: 1000px;
    margin: auto;
  }

  .toolbar {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }

  .spacer {
    flex: 1;
  }

  #statusActions {
    margin-bottom: 20px;
  }

  .line-items {
    width: 100%;
    border-collapse: collapse;
  }

  .line-items th {
    background: #020d18;
    color: white;
    padding: 12px;
    text-align: left;
  }

  .line-items td {
    padding: 12px;
    border-bottom: 1px solid #ddd;
  }


 

</style>
</head>
<body>


  <main>
    <div class="toolbar">
      <h1 style="margin:0">Order #<%= orders.id %></h1>
      <div class="spacer"></div>
      <a href="/orders" class="btn secondary">Back to Orders</a>
    </div>

    <div id="errorBox" class="error-summary" style="display:none"></div>

    <div class="card">
      <div class="detail-grid" id="orderMeta"></div>

      <div id="statusActions" style="margin-bottom:10px"></div>

      <table class="line-items">
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
          </tr>
        </thead>
        <tbody id="itemsBody">
          <% orderItems.forEach(item => { %>
            <tr>
              <td><%= item.product_name %></td>
              <td><%= item.order_items_quantity %></td>
              <td><%= item.order_items_unit_price %></td>
              <td><%= item.order_items_unit_price * item.order_items_quantity  %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>

  </script>
</body>
</html>
