<!doctype html>
<html>
    <head>
        <title>Products</title>
        <link 
        rel="stylesheet" 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        >
    </head>
<body>

    <div class="container mt-5">
    <h1>Products</h1>
    <a href="/products/add" class="btn btn-success mb-3">
        Add Product
    </a>

    <form method="GET" action="/products">

    <div class="row">


    <div class="col-md-4">

    <input
    class="form-control"
    type="text"
    name="search"
    value="<%= query.search || '' %>"
    placeholder="Search product"
    >

    </div>



    <div class="col-md-3">


    <select name="category_id" class="form-control">


    <option value="">
    All Categories
    </option>



    <% categories.forEach(category => { %>


    <option

    value="<%= category.category_id %>"

    <%= query.category_id === category.category_id ? "selected" : "" %>

    >

    <%= category.category_name %>

    </option>


    <% }) %>


    </select>


    </div>



    <div class="col-md-2">


    <button class="btn btn-primary">
    Search
    </button>


    </div>


    </div>


    </form>
    <hr>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Category</th>
                <th>Action</th>
            </tr>
        </thead>
    <tbody>
        <% products.forEach(product => { %>
            <tr>
                <td>
                    <%= product.product_name %>
                </td>
                <td>
                    <%= product.product_sku %>
                </td>
                <td>
                    <%= product.product_price %>
                </td>
                <td>
                    <%= product.product_quantity %>
                </td>
                <td>
                    <%= product.category_name || "-" %>
                </td>
                <td>
                    <a
                    href="/products/<%= product.product_id %>/edit"
                    class="btn btn-warning btn-sm"
                    >
                    Edit
                    </a>
                </td>
            </tr>
        <% }) %>

        <% if(products.length === 0){ %>
            <tr>
                <td colspan="6" class="text-center">
                    No products found
                </td>
            </tr>
        <% } %>
    </tbody>
    </table>
    <%
        let search = encodeURIComponent(query.search || "");
        let category_id = encodeURIComponent(query.category_id || "");
    %>

    <%
        const currentPage = Number(pagination.page) || 1;
        const totalPages = Number(pagination.total) || 1;
    %>

    <% if(currentPage > 1){ %>

    <a class="btn btn-secondary"
    href="/products?page=<%= currentPage-1 %>&search=<%= search %>&category_id=<%= category_id %>"
    >
    Previous
    </a>

    <% } %>

    <span class="mx-3">
        Page <%= currentPage %> of <%= totalPages %>
    </span>
    <% if(currentPage < totalPages){ %>
        <a
        class="btn btn-primary"
        href="/products?page=<%= currentPage+1 %>&search=<%= search %>&category_id=<%= category_id %>"
        >
        Next
        </a>
    <% } %>
    </div>

</body>

</html>
