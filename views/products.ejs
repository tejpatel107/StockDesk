<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Products | Stock Desk</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px;
            background: #f5f5f5;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .card {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 6px;
        }

        .filters {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        input,
        select {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        button,
        .btn {
            padding: 8px 14px;
            border: 0;
            border-radius: 4px;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-success {
            background: #16a34a;
            color: white;
        }

        .btn-secondary {
            background: #6b7280;
            color: white;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #f0f0f0;
        }

        .in-stock {
            color: #15803d;
            font-weight: bold;
        }

        .out-of-stock {
            color: #dc2626;
            font-weight: bold;
        }

        .pagination {
            margin-top: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .empty {
            text-align: center;
            padding: 20px;
            color: #777;
        }
    </style>
</head>

<body>

    <main class="container">

        <h1>Products</h1>

        <div class="card">

            <a href="/products/add" class="btn btn-success">
                Add Product
            </a>

        </div>

        <!-- Filters -->

        <div class="card">

            <form method="GET" action="/products">

                <div class="filters">

                    <!-- Search by product name or SKU -->

                    <input type="text" name="search" value="<%= query.search %>" placeholder="Search name or SKU">


                    <!-- Category -->

                    <select name="categoryId">
                        <option value="">All Categories</option>

                        <% categories.forEach(category=> { %>
                            <option value="<%= category.category_id %>">
                                <%= category.category_name %>
                            </option>
                            <% }); %>
                    </select>


                    <!-- Stock -->

                    <select name="inStock">

                        <option value="">
                            All Stock
                        </option>

                        <option value="true" <%=query.inStock==="true" ? "selected" : "" %>
                            >
                            In Stock
                        </option>

                        <option value="false" <%=query.inStock==="false" ? "selected" : "" %>
                            >
                            Out of Stock
                        </option>

                    </select>


                    <!--
                        Page size.

                        This is ready for the API once pageSize
                        is supported.

                        Uncomment/use when required.

                        <select name="pageSize">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    -->


                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>

                </div>

            </form>

        </div>


        <!-- Products -->

        <div class="card">

            <table>

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Stock</th>
                        <th>Category</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% if (products.length===0) { %>

                        <tr>
                            <td colspan="7" class="empty">
                                No products found
                            </td>
                        </tr>

                        <% } %>


                            <% products.forEach(product=> { %>

                                <tr>

                                    <td>
                                        <%= product.product_name %>
                                    </td>

                                    <td>
                                        <%= product.product_sku %>
                                    </td>

                                    <td>
                                        ₹<%= product.product_price %>
                                    </td>

                                    <td>
                                        <%= product.product_stock_quantity %>
                                    </td>

                                    <td>

                                        <% if (product.product_stock_quantity> 0) { %>

                                            <span class="in-stock">
                                                In Stock
                                            </span>

                                            <% } else { %>

                                                <span class="out-of-stock">
                                                    Out of Stock
                                                </span>

                                                <% } %>

                                    </td>

                                    <td>
                                        <%= product.category_name || "-" %>
                                    </td>

                                    <td>

                                        <a href="/products/<%= product.product_id %>/edit" class="btn btn-secondary">
                                            Edit
                                        </a>

                                    </td>

                                </tr>

                                <% }) %>

                </tbody>

            </table>


            <!-- Pagination -->

            <% const currentPage=Number(pagination.page) || 1; const totalPages=Number(pagination.totalPages) || 1; %>


                <div class="pagination">

                    <% if (currentPage> 1) { %>

                        <a class="btn btn-secondary" href="/products?<%= new URLSearchParams({
                            page: currentPage - 1,
                            search: query.search || "",
                            categoryId: query.categoryId || "",
                            inStock: query.inStock || "",
                            pageSize: query.pageSize || ""
                        }).toString() %>">
                            Previous
                        </a>

                        <% } %>


                            <span>
                                Page <%= currentPage %> of <%= totalPages %>
                            </span>


                            <% if (currentPage < totalPages) { %>

                                <a class="btn btn-primary" href="/products?<%= new URLSearchParams({
                            page: currentPage + 1,
                            search: query.search || "",
                            categoryId: query.categoryId || "",
                            inStock: query.inStock || "",
                            pageSize: query.pageSize || ""
                        }).toString() %>">
                                    Next
                                </a>

                                <% } %>

                </div>

        </div>

    </main>
    <script>
        console.log("Categories from EJS:", <% JSON.stringify(categories) %>);
    </script>
</body>

</html>