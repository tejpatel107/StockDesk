<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products | Stock Desk</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px;
            background: #f5f5f5;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .card {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 6px;
        }

        .filters {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        input,
        select {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        button,
        .btn {
            padding: 8px 14px;
            border: 0;
            border-radius: 4px;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-success {
            background: #16a34a;
            color: white;
        }

        .btn-secondary {
            background: #6b7280;
            color: white;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #f0f0f0;
        }

        .in-stock {
            color: #15803d;
            font-weight: bold;
        }

        .out-of-stock {
            color: #dc2626;
            font-weight: bold;
        }

        .pagination {
            margin-top: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .empty {
            text-align: center;
            padding: 20px;
            color: #777;
        }

        .error {
            color: #dc2626;
        }
    </style>
</head>

<body data-api-base="<%= apiBase %>" data-token="<%= token %>">

    <main class="container">

        <%- include('partials/nav', { active: 'products' }) %>

            <h1>Products</h1>

            <div class="card">
                <a href="/products/add" class="btn btn-success">Add Product</a>
            </div>

            <!-- Filters (plain GET form; state lives in the URL) -->
            <div class="card">
                <form method="GET" action="/products" id="filter-form">
                    <div class="filters">
                        <input type="text" name="search" placeholder="Search name or SKU">

                        <select name="categoryId" id="category-select">
                            <option value="">All Categories</option>
                        </select>

                        <select name="inStock">
                            <option value="">All Stock</option>
                            <option value="true">In Stock</option>
                            <option value="false">Out of Stock</option>
                        </select>

                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </form>
            </div>

            <!-- Products -->
            <div class="card">
                <p id="error" class="error" hidden></p>

                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>SKU</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Stock</th>
                            <th>Category</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="product-rows">
                        <tr>
                            <td colspan="7" class="empty">Loading...</td>
                        </tr>
                    </tbody>
                </table>

                <div class="pagination" id="pagination"></div>
            </div>

    </main>

    <script>
        const API_BASE = document.body.dataset.apiBase;
        const TOKEN = document.body.dataset.token;
        const query = new URLSearchParams(window.location.search);

        const form = document.getElementById("filter-form");
        const categorySelect = document.getElementById("category-select");
        const rowsEl = document.getElementById("product-rows");
        const paginationEl = document.getElementById("pagination");
        const errorEl = document.getElementById("error");

        async function api(path) {
            const res = await fetch(`${API_BASE}${path}`, {
                headers: { Authorization: `Bearer ${TOKEN}` },
            });

            if (res.status === 401) {
                window.location.href = "/login";
                return null;
            }
            if (!res.ok) {
                throw new Error(`API request failed (${res.status}): ${path}`);
            }
            return res.json();
        }

        function el(tag, text, className) {
            const node = document.createElement(tag);
            if (text !== undefined) node.textContent = text;
            if (className) node.className = className;
            return node;
        }

        function pageUrl(page) {
            const p = new URLSearchParams(window.location.search);
            p.set("page", page);
            return `/products?${p.toString()}`;
        }

        function renderProducts(products, categoryMap) {
            rowsEl.replaceChildren();

            if (products.length === 0) {
                const tr = el("tr");
                const td = el("td", "No products found", "empty");
                td.colSpan = 7;
                tr.appendChild(td);
                rowsEl.appendChild(tr);
                return;
            }

            for (const product of products) {
                const tr = el("tr");
                const inStock = product.product_stock_quantity > 0;

                tr.appendChild(el("td", product.product_name));
                tr.appendChild(el("td", product.product_sku));
                tr.appendChild(el("td", `₹${product.product_price}`));
                tr.appendChild(el("td", product.product_stock_quantity));

                const stockTd = el("td");
                stockTd.appendChild(
                    el("span", inStock ? "In Stock" : "Out of Stock", inStock ? "in-stock" : "out-of-stock")
                );
                tr.appendChild(stockTd);

                tr.appendChild(el("td", categoryMap.get(product.category_id) || "-"));

                const actionTd = el("td");
                const edit = el("a", "Edit", "btn btn-secondary");
                edit.href = `/products/${encodeURIComponent(product.product_id)}/edit`;
                actionTd.appendChild(edit);
                tr.appendChild(actionTd);

                rowsEl.appendChild(tr);
            }
        }

        function renderPagination(page, totalPages) {
            paginationEl.replaceChildren();

            if (page > 1) {
                const prev = el("a", "Previous", "btn btn-secondary");
                prev.href = pageUrl(page - 1);
                paginationEl.appendChild(prev);
            }

            paginationEl.appendChild(el("span", `Page ${page} of ${totalPages}`));

            if (page < totalPages) {
                const next = el("a", "Next", "btn btn-primary");
                next.href = pageUrl(page + 1);
                paginationEl.appendChild(next);
            }
        }

        async function load() {
            // Restore filter values from the URL
            form.elements.search.value = query.get("search") || "";
            form.elements.inStock.value = query.get("inStock") || "";

            // Only forward the params the API supports
            const params = new URLSearchParams();
            params.set("page", query.get("page") || "1");
            for (const key of ["pageSize", "search", "categoryId", "inStock"]) {
                if (query.get(key)) params.set(key, query.get(key));
            }

            try {
                const [productResult, categoryResult] = await Promise.all([
                    api(`/products?${params.toString()}`),
                    api("/categories"),
                ]);
                if (!productResult || !categoryResult) return; // redirected to login

                const categories = categoryResult.categories || [];
                const products = productResult.products || [];

                for (const category of categories) {
                    const option = el("option", category.category_name);
                    option.value = category.category_id;
                    categorySelect.appendChild(option);
                }
                categorySelect.value = query.get("categoryId") || "";

                const categoryMap = new Map(categories.map(c => [c.category_id, c.category_name]));

                renderProducts(products, categoryMap);
                renderPagination(
                    Number(productResult.page) || Number(query.get("page")) || 1,
                    Number(productResult.totalPages) || 1
                );
            } catch (err) {
                console.error(err);
                rowsEl.replaceChildren();
                errorEl.textContent = err.message;
                errorEl.hidden = false;
            }
        }

        load();
    </script>
</body>

</html>