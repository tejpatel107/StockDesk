<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>StockDesk — Orders</title>

    <style>
        .card {
            padding: 16px;
            margin-bottom: 16px;
        }

        .toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .toolbar label {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .toolbar input,
        .toolbar select,
        .toolbar button {
            padding: 7px 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #eee;
            padding: 8px;
            border: 1px solid #ccc;
            text-align: left;
        }

        td {
            padding: 8px;
            border: 1px solid #ccc;
        }

        tbody tr {
            cursor: pointer;
        }

        tbody tr:hover {
            background: #f5f5f5;
        }

        .empty-state {
            text-align: center;
            padding: 20px;
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            margin-top: 16px;
        }

        .pagination a {
            text-decoration: none;
            padding: 6px 12px;
            border: 1px solid #ccc;
        }

        .pagination .disabled {
            color: #999;
            pointer-events: none;
        }
    </style>
</head>

<body>

    <main>
        <h1>Orders</h1>

        <!-- Filters -->
        <form method="GET" action="/orders" class="toolbar card">

            <label>
                Status
                <select name="status">
                    <option value="">All statuses</option>

                    <option value="PENDING" <%=query.status==="PENDING" ? "selected" : "" %>
                        >
                        Pending
                    </option>

                    <option value="CONFIRMED" <%=query.status==="CONFIRMED" ? "selected" : "" %>
                        >
                        Confirmed
                    </option>

                    <option value="SHIPPED" <%=query.status==="SHIPPED" ? "selected" : "" %>
                        >
                        Shipped
                    </option>

                    <option value="DELIVERED" <%=query.status==="DELIVERED" ? "selected" : "" %>
                        >
                        Delivered
                    </option>

                    <option value="CANCELLED" <%=query.status==="CANCELLED" ? "selected" : "" %>
                        >
                        Cancelled
                    </option>
                </select>
            </label>


            <label>
                Start date
                <input type="date" name="startDate" value="<%= query.startDate || "" %>" />
            </label>


            <label>
                End date
                <input type="date" name="endDate" value="<%= query.endDate || "" %>" />
            </label>


            <label>
                Sort
                <select name="sort">
                    <option value="DESC" <%=query.sort==="DESC" || !query.sort ? "selected" : "" %>
                        >
                        Newest first
                    </option>

                    <option value="ASC" <%=query.sort==="ASC" ? "selected" : "" %>
                        >
                        Oldest first
                    </option>
                </select>
            </label>


            <label>
                Page size
                <select name="pageSize">

                    <option value="10" <%=String(query.pageSize || 10)==="10" ? "selected" : "" %>
                        >
                        10
                    </option>

                    <option value="25" <%=String(query.pageSize)==="25" ? "selected" : "" %>
                        >
                        25
                    </option>

                    <option value="50" <%=String(query.pageSize)==="50" ? "selected" : "" %>
                        >
                        50
                    </option>

                </select>
            </label>


            <button type="submit">
                Apply
            </button>

            <a href="/orders">
                Clear
            </a>

        </form>


        <!-- Orders table -->
        <div class="card" style="padding: 0">

            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody id="ordersBody">

                    <% if (orders && orders.length> 0) { %>

                        <% orders.forEach(order=> { %>

                            <tr onclick="handleOrderItem('<%= order.order_id %>')">

                                <td>
                                    <%= order.order_id %>
                                </td>

                                <td>
                                    <%= order.customer_name %>
                                </td>

                                <td>
                                    <%= order.order_item_count %>
                                </td>

                                <td>
                                    <%= order.order_total_amount %>
                                </td>

                                <td>
                                    <%= order.order_status %>
                                </td>

                                <td>
                                    <%= new Date(order.order_date).toLocaleDateString() %>
                                </td>

                            </tr>

                            <% }) %>

                                <% } else { %>

                                    <tr>
                                        <td colspan="6" class="empty-state">
                                            No orders found.
                                        </td>
                                    </tr>

                                    <% } %>

                </tbody>
            </table>

        </div>


        <!-- Pagination -->
        <% const currentPage=Number(query.page || 1); const pageSize=Number(query.pageSize || 10); const
            totalOrders=Number( orders?.[0]?.total_number_of_orders || 0 ); const totalPages=Math.ceil(totalOrders /
            pageSize); const createPageUrl=(page)=> {
            const params = new URLSearchParams();

            params.set("page", page);
            params.set("pageSize", pageSize);

            if (query.status) {
            params.set("status", query.status);
            }

            if (query.startDate) {
            params.set("startDate", query.startDate);
            }

            if (query.endDate) {
            params.set("endDate", query.endDate);
            }

            if (query.sort) {
            params.set("sort", query.sort);
            }

            return `/orders?${params.toString()}`;
            };
            %>


            <% if (totalPages> 1) { %>

                <div class="pagination">

                    <% if (currentPage> 1) { %>

                        <a href="<%= createPageUrl(currentPage - 1) %>">
                            Previous
                        </a>

                        <% } else { %>

                            <span class="disabled">
                                Previous
                            </span>

                            <% } %>


                                <span>
                                    Page <%= currentPage %> of <%= totalPages %>
                                </span>


                                <% if (currentPage < totalPages) { %>

                                    <a href="<%= createPageUrl(currentPage + 1) %>">
                                        Next
                                    </a>

                                    <% } else { %>

                                        <span class="disabled">
                                            Next
                                        </span>

                                        <% } %>

                </div>

                <% } %>

    </main>


    <script>
        function handleOrderItem(id) {
            window.location.href = `/orders/${id}`;
        }
    </script>

</body>

</html>