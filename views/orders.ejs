<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>StockDesk — Orders</title>

    <style>
        .card {
            padding: 16px;
            margin-bottom: 16px;
        }

        .toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .toolbar label {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .toolbar input,
        .toolbar select,
        .toolbar button {
            padding: 7px 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #eee;
            padding: 8px;
            border: 1px solid #ccc;
            text-align: left;
        }

        td {
            padding: 8px;
            border: 1px solid #ccc;
        }

        tbody tr {
            cursor: pointer;
        }

        tbody tr:hover {
            background: #f5f5f5;
        }

        .empty-state {
            text-align: center;
            padding: 20px;
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            margin-top: 16px;
        }

        .pagination a {
            text-decoration: none;
            padding: 6px 12px;
            border: 1px solid #ccc;
        }

        .pagination .disabled {
            color: #999;
            pointer-events: none;
        }

        .error {
            color: #b00020;
        }
    </style>
</head>

<body>
    <main>

        <%- include('partials/nav', { active: 'orders' }) %>
        <h1>Orders</h1>

        <!-- Filters (still a GET form to the page router) -->
        <form method="GET" action="/orders" class="toolbar card">
            <label>
                Status
                <select name="status">
                    <option value="">All statuses</option>
                    <% ["PENDING","CONFIRMED","SHIPPED","DELIVERED","CANCELLED"].forEach(s=> { %>
                        <option value="<%= s %>" <%=query.status===s ? "selected" : "" %>>
                            <%= s.charAt(0) + s.slice(1).toLowerCase() %>
                        </option>
                        <% }) %>
                </select>
            </label>

            <label>
                Start date
                <input type="date" name="startDate" value="<%= query.startDate %>" />
            </label>

            <label>
                End date
                <input type="date" name="endDate" value="<%= query.endDate %>" />
            </label>

            <label>
                Sort
                <select name="sort">
                    <option value="DESC" <%=query.sort !=="ASC" ? "selected" : "" %>>Newest first</option>
                    <option value="ASC" <%=query.sort==="ASC" ? "selected" : "" %>>Oldest first</option>
                </select>
            </label>

            <label>
                Page size
                <select name="pageSize">
                    <% ["10","25","50"].forEach(n=> { %>
                        <option value="<%= n %>" <%=String(query.pageSize)===n ? "selected" : "" %>><%= n %>
                        </option>
                        <% }) %>
                </select>
            </label>

            <button type="submit">Apply</button>
            <a href="/orders">Clear</a>
        </form>

        <!-- Orders table (filled by JS) -->
        <div class="card" style="padding: 0">
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody id="ordersBody">
                    <tr>
                        <td colspan="6" class="empty-state">Loading...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="pagination" id="pagination"></div>
    </main>

    <script>
        const API_BASE = "<%= apiBase %>";
        const TOKEN = "<%= token %>";
        const QUERY = <%- JSON.stringify(query).replace(/</g, "\\u003c") %>;

        const body = document.getElementById("ordersBody");
        const pager = document.getElementById("pagination");

        function messageRow(text, cls) {
            body.innerHTML = "";
            const tr = document.createElement("tr");
            const td = document.createElement("td");
            td.colSpan = 6;
            td.className = "empty-state " + (cls || "");
            td.textContent = text;
            tr.appendChild(td);
            body.appendChild(tr);
        }

        function renderRows(orders) {
            body.innerHTML = "";
            if (!orders.length) return messageRow("No orders found.");

            orders.forEach((o) => {
                const tr = document.createElement("tr");
                const cells = [
                    o.order_id,
                    o.customer_name,
                    o.order_item_count,
                    o.order_total_amount,
                    o.order_status,
                    new Date(o.order_date).toLocaleDateString(),
                ];
                cells.forEach((v) => {
                    const td = document.createElement("td");
                    td.textContent = v ?? "";
                    tr.appendChild(td);
                });
                tr.addEventListener("click", () => {
                    window.location.href = "/orders/" + encodeURIComponent(o.order_id);
                });
                body.appendChild(tr);
            });
        }

        function pageUrl(page) {
            const p = new URLSearchParams();
            p.set("page", page);
            p.set("pageSize", QUERY.pageSize);
            ["status", "startDate", "endDate", "sort"].forEach((k) => {
                if (QUERY[k]) p.set(k, QUERY[k]);
            });
            return "/orders?" + p.toString();
        }

        function renderPagination(total) {
            pager.innerHTML = "";
            const current = Number(QUERY.page) || 1;
            const totalPages = Math.ceil(total / (Number(QUERY.pageSize) || 10));
            if (totalPages <= 1) return;

            const link = (label, page, enabled) => {
                const el = document.createElement(enabled ? "a" : "span");
                el.textContent = label;
                if (enabled) el.href = pageUrl(page);
                else el.className = "disabled";
                pager.appendChild(el);
            };

            link("Previous", current - 1, current > 1);
            const info = document.createElement("span");
            info.textContent = `Page ${current} of ${totalPages}`;
            pager.appendChild(info);
            link("Next", current + 1, current < totalPages);
        }

        async function loadOrders() {
            const params = new URLSearchParams();
            params.set("page", QUERY.page);
            params.set("pageSize", QUERY.pageSize);
            params.set("sort", QUERY.sort || "DESC");
            if (QUERY.status) params.set("status", QUERY.status);
            if (QUERY.startDate) params.set("startDate", QUERY.startDate);
            if (QUERY.endDate) params.set("endDate", QUERY.endDate);

            try {
                const res = await fetch(`${API_BASE}/orders?${params}`, {
                    headers: { Authorization: `Bearer ${TOKEN}` },
                });

                if (res.status === 401) return (window.location.href = "/login");

                const result = await res.json();
                if (!res.ok || result.success === false) {
                    return messageRow(result.message || "Failed to load orders.", "error");
                }

                const orders = result.orders || [];
                renderRows(orders);
                renderPagination(Number(orders[0]?.total_number_of_orders || 0));
            } catch (err) {
                console.error(err);
                messageRow("Could not reach the server.", "error");
            }
        }

        loadOrders();
    </script>
</body>

</html>